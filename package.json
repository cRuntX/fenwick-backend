{
  "name": "fenwick-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend server for Fenwick diagram",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "backup": "node backup-data.js",
    "export": "node export-local-data.js",
    "sync": "node sync-to-production.js",
    "replace": "node replace-production.js",
    "migrate": "node migrate-data-smart.js",
    "optimize": "node auto-optimize-images.js",
    "extract-images": "node extract-and-optimize-images.js",
    "reupload-images": "node optimize-and-reupload-images.js",
    "check-production": "node check-production.js",
    "analyze-activity": "node analyze-activity.js",
    "analyze-years": "node analyze-years.js",
    "vacuum": "node -e \"import sqlite3 from 'sqlite3'; const db = new sqlite3.Database('./fenwick.db'); db.run('VACUUM', (err) => { if(err) { console.error('❌ Error:', err); process.exit(1); } console.log('✅ Database optimized!'); db.close(); });\"",
    "clear-images": "node clear-images.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "puppeteer": "^24.24.0",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
