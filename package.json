{
  "name": "fenwick-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend server for Fenwick diagram",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check": "node check-data.js",
    "sync": "node safe-sync.js",
    "pull": "node export-from-supabase.js && node import-to-local.js",
    "optimize": "node optimize-supabase-images.js",
    "backup": "node export-from-supabase.js",
    "export": "node export-local-data.js",
    "import": "node import-to-local.js",
    "vacuum": "node -e \"import sqlite3 from 'sqlite3'; const db = new sqlite3.Database('./fenwick.db'); db.run('VACUUM', (err) => { if(err) { console.error('❌ Error:', err); process.exit(1); } console.log('✅ Database optimized!'); db.close(); });\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "puppeteer": "^24.24.0",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
